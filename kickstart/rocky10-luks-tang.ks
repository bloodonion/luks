# =====================================================================
# Rocky Linux 10.2 - encrypted OS disks with Tang (network) unlock
#
# - %pre finds the OS disks by size and ONLY those are visible to the
#   installer (ignoredisk), so data disks are never touched.
# - 1 OS disk  -> plain layout.  2 OS disks -> mdadm RAID1.
# - The LUKS volume is bound to Tang in %post, so the server unlocks
#   itself over the network on every boot.
#
# Edit the SETTINGS block in %pre. Sections marked "YOUR SETTINGS" are
# examples; replace them with what your ISO already uses.
# =====================================================================

# ---------- YOUR SETTINGS (examples) ---------------------------------
text
cdrom
lang en_AU.UTF-8
keyboard us
timezone Australia/Sydney --utc
network --bootproto=dhcp --activate --onboot=yes
# network --bootproto=static --device=ens3 --ip=10.0.0.20 --netmask=255.255.255.0 --gateway=10.0.0.1 --nameserver=10.0.0.2 --activate
rootpw --lock
user --name=ansible --groups=wheel --lock
sshkey --username=ansible "ssh-ed25519 AAAA...replace-me ansible@controller"
selinux --enforcing
firewall --enabled --ssh
services --enabled=sshd
reboot --eject
# ---------------------------------------------------------------------

# REQUIRED: storage, generated by %pre
%include /tmp/ks-storage.ks

%packages
@^minimal-environment
# REQUIRED for encryption + Tang unlock
cryptsetup
clevis
clevis-luks
clevis-dracut
clevis-systemd
mdadm
lvm2
%end

# =====================================================================
# %pre: choose OS disks and write the partition layout
# =====================================================================
%pre --interpreter=/bin/bash --erroronfail --log=/tmp/ks-pre.log
# ============================ SETTINGS ===============================
# OS disks = whole disks inside this size window (decimal GB), not
# removable, not USB. Make sure your data disks are OUTSIDE it.
OS_DISK_MIN_GB=200
OS_DISK_MAX_GB=4000
OS_DISK_REGEX='^(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+)$'
# auto = 1 disk (plain) or 2 disks (RAID1); anything else stops.
# Set 1 or 2 to require an exact count.
OS_DISK_COUNT=auto
# Skip detection and use these disks, e.g. "nvme0n1 nvme1n1"
OS_DISKS_OVERRIDE=""

# Temporary LUKS passphrase. Ansible later enrols its own DR key and
# removes this one. No quotes or backslashes in it.
LUKS_INSTALL_PASSPHRASE='ChangeMe-Install-Only'

# Tang servers: space separated, thumbprints in the same order.
# Thumbprint: luks-keys/tang/<host>.thp, or run tang-show-keys 7500
TANG_URLS="http://10.0.0.5:7500"
TANG_THPS="REPLACE_WITH_TANG_THUMBPRINT"
TANG_THRESHOLD=1

# Network in the initramfs (needed to reach Tang at boot):
#   auto - static IP if the install used one, otherwise DHCP
#   dhcp - always DHCP
INITRD_NET=auto

EFI_MIB=600
BOOT_MIB=1024
SWAP_MIB=8192
VG_NAME=rl
# =====================================================================

die()  { echo "KICKSTART STOPPED: $*" | tee /dev/console >&2; exit 1; }
info() { echo "ks: $*" | tee /dev/console >&2; }

# ---- 1. Find the OS disks ------------------------------------------
min=$(( OS_DISK_MIN_GB * 1000000000 ))
max=$(( OS_DISK_MAX_GB * 1000000000 ))

if [ -n "$OS_DISKS_OVERRIDE" ]; then
  read -ra DISKS <<< "$OS_DISKS_OVERRIDE"
else
  mapfile -t DISKS < <(
    lsblk -dbnlo NAME,SIZE,TYPE,RM,TRAN | while read -r name size type rm tran; do
      [ "$type" = disk ] || continue
      [ "$rm" = 0 ] || continue
      [ "${tran:-}" = usb ] && continue
      [[ "$name" =~ $OS_DISK_REGEX ]] || continue
      [ "$size" -ge "$min" ] && [ "$size" -le "$max" ] && echo "$name"
    done | sort
  )
fi

info "disks in the OS size window: ${DISKS[*]:-none}"
n=${#DISKS[@]}
case "$OS_DISK_COUNT" in
  auto) [ "$n" -eq 1 ] || [ "$n" -eq 2 ] || die "expected 1 or 2 OS disks, found $n (${DISKS[*]:-none}). Adjust OS_DISK_MIN_GB/MAX_GB or set OS_DISKS_OVERRIDE." ;;
  *)    [ "$n" -eq "$OS_DISK_COUNT" ] || die "expected $OS_DISK_COUNT OS disks, found $n (${DISKS[*]:-none})." ;;
esac

# ---- 2. Safety checks: never take a disk that holds data -------------
for d in "${DISKS[@]}"; do
  [ -b "/dev/$d" ] || die "/dev/$d does not exist"
  if lsblk -nlo LABEL "/dev/$d" | grep -qx 'ansible-luks'; then
    die "/dev/$d holds a data volume encrypted by Ansible (label ansible-luks)"
  fi
done

# A selected disk must not belong to an md array that also uses
# disks outside the selection (e.g. half of the data array).
declare -A SEL MD_IN MD_OUT
for d in "${DISKS[@]}"; do SEL[$d]=1; done
while read -r dev; do
  uuid=$(mdadm --examine --export "$dev" 2>/dev/null | sed -n 's/^MD_UUID=//p')
  [ -n "$uuid" ] || continue
  parent=$(lsblk -no PKNAME "$dev" 2>/dev/null | head -n1)
  disk=${parent:-$(basename "$dev")}
  if [ -n "${SEL[$disk]:-}" ]; then MD_IN[$uuid]+="$disk "; else MD_OUT[$uuid]+="$disk "; fi
done < <(lsblk -nlpo NAME,TYPE | awk '$2 == "disk" || $2 == "part" {print $1}')
for uuid in "${!MD_IN[@]}"; do
  if [ -n "${MD_OUT[$uuid]:-}" ]; then
    die "RAID array $uuid spans OS disks (${MD_IN[$uuid]}) and other disks (${MD_OUT[$uuid]}). Refusing."
  fi
done

# ---- 3. Write the layout ------------------------------------------
[ -d /sys/firmware/efi ] && FW=uefi || FW=bios
D1=${DISKS[0]}
D2=${DISKS[1]:-}
DRIVES=$(IFS=,; echo "${DISKS[*]}")
ENC="--encrypted --luks-version=luks2 --passphrase=$LUKS_INSTALL_PASSPHRASE"

{
  echo "ignoredisk --only-use=$DRIVES"
  echo "zerombr"
  echo "clearpart --all --initlabel --drives=$DRIVES"
  if [ -z "$D2" ]; then
    info "layout: single disk $D1 ($FW)"
    echo "bootloader --location=mbr --boot-drive=$D1"
    if [ "$FW" = uefi ]; then
      echo "part /boot/efi --fstype=efi --size=$EFI_MIB --ondisk=$D1"
    else
      echo "part biosboot --fstype=biosboot --size=1 --ondisk=$D1"
    fi
    echo "part /boot --fstype=xfs --size=$BOOT_MIB --ondisk=$D1"
    echo "part pv.01 --fstype=lvmpv --size=1 --grow --ondisk=$D1 $ENC"
  else
    info "layout: RAID1 on $D1 + $D2 ($FW)"
    echo "bootloader --location=mbr --driveorder=$D1,$D2"
    if [ "$FW" = uefi ]; then
      echo "part raid.11 --size=$EFI_MIB --ondisk=$D1"
      echo "part raid.12 --size=$EFI_MIB --ondisk=$D2"
      echo "raid /boot/efi --level=1 --device=efi --fstype=efi raid.11 raid.12"
    else
      # Second biosboot has no mount point name (two "biosboot" lines are rejected)
      echo "part biosboot --fstype=biosboot --size=1 --ondisk=$D1"
      echo "part None --fstype=biosboot --size=1 --ondisk=$D2"
    fi
    echo "part raid.21 --size=$BOOT_MIB --ondisk=$D1"
    echo "part raid.22 --size=$BOOT_MIB --ondisk=$D2"
    echo "raid /boot --level=1 --device=boot --fstype=xfs raid.21 raid.22"
    echo "part raid.31 --size=1 --grow --ondisk=$D1"
    echo "part raid.32 --size=1 --grow --ondisk=$D2"
    echo "raid pv.01 --level=1 --device=pv $ENC raid.31 raid.32"
  fi
  echo "volgroup $VG_NAME pv.01"
  echo "logvol swap --vgname=$VG_NAME --name=swap --size=$SWAP_MIB"
  echo "logvol / --vgname=$VG_NAME --name=root --fstype=xfs --size=1 --grow"
} > /tmp/ks-storage.ks

# Settings %post needs (passphrase file is shredded at the end)
OS_DISKS="${DISKS[*]}"
declare -p LUKS_INSTALL_PASSPHRASE TANG_URLS TANG_THPS TANG_THRESHOLD INITRD_NET OS_DISKS > /tmp/ks-luks.env
chmod 0600 /tmp/ks-luks.env
info "storage layout written"
%end

# =====================================================================
# %post (installer side): copy settings in, capture network for initramfs
# =====================================================================
%post --nochroot --interpreter=/bin/bash --log=/mnt/sysimage/root/ks-post-nochroot.log
install -m 0600 /tmp/ks-luks.env /mnt/sysimage/root/ks-luks.env
. /tmp/ks-luks.env

INITRD_IPARG=""
if [ "$INITRD_NET" = auto ]; then
  dev=$(ip -4 route show default | awk '{print $5; exit}')
  con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
  method=$(nmcli -g ipv4.method connection show "$con" 2>/dev/null)
  if [ "$method" = manual ]; then
    cidr=$(ip -4 -o addr show dev "$dev" | awk '{print $4; exit}')
    addr=${cidr%/*}
    mask=$(python3 -c "import ipaddress; print(ipaddress.ip_network('0.0.0.0/${cidr#*/}').netmask)")
    gw=$(ip -4 route show default dev "$dev" | awk '{print $3; exit}')
    INITRD_IPARG="ip=$addr::$gw:$mask::$dev:none"
    for ns in $(awk '/^nameserver/ {print $2}' /etc/resolv.conf); do
      INITRD_IPARG+=" nameserver=$ns"
    done
  fi
fi
echo "initramfs network: ${INITRD_IPARG:-dhcp}"
printf 'INITRD_IPARG=%q\n' "$INITRD_IPARG" >> /mnt/sysimage/root/ks-luks.env
%end

# =====================================================================
# %post (installed system): bind to Tang, network in initramfs
# =====================================================================
%post --interpreter=/bin/bash --log=/root/ks-post-luks.log
. /root/ks-luks.env
warn() { echo "WARNING: $*" | tee /dev/console; }

# The LUKS device on the OS disks (a partition, or the md array)
LUKSDEV=$(for d in $OS_DISKS; do lsblk -nlpo NAME,FSTYPE "/dev/$d"; done \
          | awk '$2 == "crypto_LUKS" {print $1}' | sort -u)
if [ "$(echo "$LUKSDEV" | grep -c .)" -ne 1 ]; then
  warn "expected one LUKS device on $OS_DISKS, found: ${LUKSDEV:-none}. Tang not bound."
else
  echo "LUKS device: $LUKSDEV"

  # sss policy for one or more Tang servers
  read -ra URLS <<< "$TANG_URLS"
  read -ra THPS <<< "$TANG_THPS"
  PINS=""
  for i in "${!URLS[@]}"; do
    PINS+="${PINS:+,}{\"url\":\"${URLS[$i]}\",\"thp\":\"${THPS[$i]}\"}"
  done
  CFG="{\"t\":$TANG_THRESHOLD,\"pins\":{\"tang\":[$PINS]}}"
  echo "clevis policy: $CFG"

  if printf '%s' "$LUKS_INSTALL_PASSPHRASE" | clevis luks bind -y -d "$LUKSDEV" -k - sss "$CFG"; then
    SLOT=$(clevis luks list -d "$LUKSDEV" | awk -F: '/sss|tang/ {print $1; exit}')
    if clevis luks pass -d "$LUKSDEV" -s "$SLOT" | cryptsetup open --test-passphrase --key-file=- "$LUKSDEV"; then
      echo "Tang binding verified (slot $SLOT)"
    else
      warn "Tang binding exists but could not be verified"
    fi
  else
    warn "Tang binding failed. Unlock at the console until Ansible binds it."
  fi
fi

# Network in the initramfs so clevis can reach Tang at boot
grubby --update-kernel=ALL --args="rd.neednet=1 ${INITRD_IPARG}"
dracut -f --regenerate-all

# Remove the install passphrase from files left on the system
shred -u /root/ks-luks.env
for f in /root/original-ks.cfg /root/anaconda-ks.cfg; do
  [ -f "$f" ] && sed -i "s/^LUKS_INSTALL_PASSPHRASE=.*/LUKS_INSTALL_PASSPHRASE='<removed>'/" "$f"
done
%end
